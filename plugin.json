{
  "id": "neodex.music",
  "name": "NeoMusic",
  "version": "1.7.3",
  "author": "NDesumeur",
  "description": "Ton lecteur de musique : playlists en ligne et hors ligne, thèmes, spectre, égaliseur, statistiques, succès et raccourcis globaux.",
  "icon": "icon.png",
  "entry": "index.js",
  "view": "music",
  "neobase": ">=4.1.0",
  "type": "app",
  "category": "Musique",
  "mobile": true,
  "system": false,
  "dependencies": {},
  "main": "main.js",
  "sync": {
    "library": {
      "auto": [
        "session",
        "stats.*",
        "achievements"
      ],
      "union": [
        "stats.history"
      ]
    }
  },
  "sdk": "2.1.0",
  "permissions": [
    "storage",
    "music",
    "system:main"
  ]
}
