{
  "id": "neodex.music",
  "name": "NeoMusic",
  "version": "2.4.4",
  "author": "NDesumeur",
  "description": "Lecteur de musique : playlists en streaming ou téléchargées, ajout depuis YouTube, SoundCloud, Deezer ou un fichier CSV, favoris, radar des sorties et découvertes chaque semaine. Égaliseur 10 bandes, limiteur, ReplayGain, mode sommeil, réveil, petit lecteur flottant et raccourcis globaux. Statistiques détaillées, 34 succès, niveaux qui débloquent thèmes, visualiseur et platine vinyle.",
  "icon": "icon.png",
  "entry": "index.js",
  "view": "music",
  "neobase": ">=4.1.0",
  "neodex": ">=3.2.0",
  "type": "app",
  "category": "Musique",
  "syncMode": "fusion",
  "syncInfo": "Seuls les playlists, le niveau et les succès voyagent. Réglages, morceau en cours, file d'attente et historique d'écoute restent sur chaque appareil.",
  "mobile": true,
  "compatibility": [
    "windows",
    "android",
    "linux"
  ],
  "system": false,
  "dependencies": {},
  "main": "main.js",
  "sync": {
    "library": {
      "share": [
        "playlists",
        "stats",
        "achievements",
        "-stats.history"
      ],
      "auto": [
        "session",
        "stats.*",
        "achievements"
      ],
      "union": [
        "stats.history"
      ]
    }
  },
  "sdk": "2.1.0",
  "permissions": [
    "storage",
    "music",
    "system:main",
    "widget"
  ],
  "commands": [
    {
      "id": "toggle",
      "title": "Lecture / pause",
      "background": true
    },
    {
      "id": "next",
      "title": "Morceau suivant",
      "background": true
    },
    {
      "id": "prev",
      "title": "Morceau précédent",
      "background": true
    },
    {
      "id": "fav",
      "title": "Ajouter ou retirer des favoris",
      "background": true
    }
,
    {
      "id": "volup",
      "title": "Monter le volume",
      "background": true
    },
    {
      "id": "voldown",
      "title": "Baisser le volume",
      "background": true
    }
  ],
  "widget": "widget.js"
}
